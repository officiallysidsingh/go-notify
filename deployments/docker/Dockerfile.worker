# syntax=docker/dockerfile:1

FROM --platform=$BUILDPLATFORM golang:1.26.3-bookworm AS builder
WORKDIR /src
ARG TARGETARCH

# Copy modules first for better layer caching.
COPY go.mod go.sum ./
RUN go mod download

COPY . .
ENV CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH
RUN go build -trimpath -ldflags="-s -w" -o /out/worker_service ./cmd/worker

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /out/worker_service /app/worker_service
EXPOSE 9092
USER nonroot:nonroot
ENTRYPOINT ["/app/worker_service"]
